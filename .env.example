# Viral Video — environment variables
# Copy these into Render's Environment Variables page (NOT into git, NOT into chat).

# Fresh bot token from @BotFather. If a token was ever posted in a chat,
# revoke it first with /revoke and use the NEW one here.
BOT_TOKEN=

# Your Telegram user id from @userinfobot (numbers only).
ADMIN_ID=

# Public https URL of this service, e.g. https://viral-video-bot.onrender.com
# Set this AFTER the first deploy (the host gives you the URL), then deploy again.
WEBAPP_URL=

# Bot update mode: "polling" (default, Render-style) or "webhook"
# (PythonAnywhere-style: Telegram calls the bot, so the app may sleep
# between messages and wake on demand).
BOT_MODE=polling

# Optional webhook path secret. Leave empty and it is derived from
# BOT_TOKEN automatically — no extra setup needed.
WEBHOOK_SECRET=

# Optional outbound proxy for free-tier hosts that restrict direct egress.
# PythonAnywhere free accounts need: http://proxy.server:3128
TG_PROXY=

# Monetag (optional at first — without these the app runs in TEST MODE).
# From the Monetag dashboard: Telegram Mini Apps -> your app -> "Get SDK".
MONETAG_ZONE_ID=
MONETAG_SDK_URL=

# Render sets PORT automatically. You do not need to set it.
# PORT=8080
